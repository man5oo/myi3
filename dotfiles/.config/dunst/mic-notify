#!/bin/sh

# myi3 di manuel - v1.0

STATUS=$(wpctl get-volume @DEFAULT_AUDIO_SOURCE@)
VOL=$(echo "$STATUS" | awk '{printf "%d", $2*100}')

if echo "$STATUS" | grep -q MUTED; then
  ICON=audio-input-microphone-muted-symbolic
else
  if [ "$VOL" -lt 30 ]; then
    ICON=audio-input-microphone-low-symbolic
  elif [ "$VOL" -lt 70 ]; then
    ICON=audio-input-microphone-medium-symbolic
  else
    ICON=audio-input-microphone-high-symbolic
  fi
fi

/usr/bin/dunstify \
  -a volume \
  -i $ICON \
  -h int:value:"$VOL" \
  -h int:max:100 \
  -r 9992 \
  "Microphone $VOL%"
