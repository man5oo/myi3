#!/usr/bin/env bash

# myi3 di manuel - v1.0

SINK="@DEFAULT_AUDIO_SINK@"
STEP="${STEP:-5%}"

case $BLOCK_BUTTON in
  3) wpctl set-mute $SINK toggle ;;           
  4) wpctl set-volume $SINK ${STEP}+ ;;         
  5) wpctl set-volume $SINK ${STEP}- ;;        
esac

status=$(wpctl get-volume $SINK)
pct=$(echo "$status" | awk '{printf "%d", $2*100}')

if [[ "$status" == *MUTED* ]]; then
    echo " "
    echo " "
    echo "#F28B82"
else
    echo "   ${pct}%"
fi
