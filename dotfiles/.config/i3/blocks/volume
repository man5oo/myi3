#!/usr/bin/env bash

SINK="@DEFAULT_AUDIO_SINK@"
STEP="${STEP:-5%}"

case $BLOCK_BUTTON in
  3) wpctl set-mute $SINK toggle ;;            # right click, mute/unmute
  4) wpctl set-volume $SINK ${STEP}+ ;;         # scroll up, increase
  5) wpctl set-volume $SINK ${STEP}- ;;         # scroll down, decrease
esac

status=$(wpctl get-volume $SINK)
pct=$(echo "$status" | awk '{printf "%d", $2*100}')

if [[ "$status" == *MUTED* ]]; then
    echo " "
    echo " "
    echo "#F28B82"
else
    echo "   ${pct}%"
fi
