#!/usr/bin/env bash

# myi3 di manuel - v1.0

set -u

DISPLAY_NAME="eDP-1"
TOUCHSCREEN_NAME="ELAN Touchscreen"

sensor_pid=""

ID=$(xinput list --id-only "$TOUCHSCREEN_NAME" 2>/dev/null) || exit 1

apply_orientation() {
    local rotation
    local matrix

    case "$1" in
        normal)
            rotation="normal"
            matrix="1 0 0 0 1 0 0 0 1"
            ;;
        left-up)
            rotation="left"
            matrix="0 -1 1 1 0 0 0 0 1"
            ;;
        right-up)
            rotation="right"
            matrix="0 1 0 -1 0 1 0 0 1"
            ;;
        bottom-up)
            rotation="inverted"
            matrix="-1 0 1 0 -1 1 0 0 1"
            ;;
        *)
            return 0
            ;;
    esac

    xrandr --output "$DISPLAY_NAME" --rotate "$rotation" || {
        echo "Error: display rotation failed." >&2
        return 1
    }

    xinput set-prop "$ID" \
        "Coordinate Transformation Matrix" $matrix || {
        echo "Error: touchscreen mapping failed." >&2
        return 1
    }
}

cleanup() {
    if [[ -n "$sensor_pid" ]]; then
        kill "$sensor_pid" 2>/dev/null || true
        wait "$sensor_pid" 2>/dev/null || true
    fi

    xrandr --output "$DISPLAY_NAME" --rotate normal \
        2>/dev/null || true

    xinput set-prop "$ID" \
        "Coordinate Transformation Matrix" \
        1 0 0 0 1 0 0 0 1 2>/dev/null || true
}

trap cleanup EXIT
trap 'exit 0' INT TERM HUP

for cmd in monitor-sensor xrandr xinput; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "Error: missing dependency: $cmd" >&2
        exit 1
    }
done

xrandr --query | grep -Fq \
    "$DISPLAY_NAME connected" || {
    echo "Error: display '$DISPLAY_NAME' not connected." >&2
    exit 1
}

xinput list --id-only | grep \
    "$ID" || {
    echo "Error: touchscreen '$TOUCHSCREEN_NAME' not found." >&2
    exit 1
}

exec {sensor_fd}< <(monitor-sensor)
sensor_pid=$!

while IFS= read -r line <&"$sensor_fd"; do
    case "$line" in
        *"Accelerometer orientation changed:"*)
            apply_orientation "${line##*: }"
            ;;
        *"Accelerometer orientation:"*)
            apply_orientation "${line##*: }"
            ;;
    esac
done

exit 0
